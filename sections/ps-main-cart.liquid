<section class="ps-page"><div class="ps-page__inner"><h1>Your cart</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="ps-cart-items">{% for item in cart.items %}<div class="ps-cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy' }}</a>{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money }}</p><label for="ps-qty-{{ forloop.index }}">Quantity</label><input id="ps-qty-{{ forloop.index }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}"><a href="{{ item.url_to_remove }}">Remove</a></div></div>{% endfor %}</div><p class="ps-price">Subtotal: {{ cart.total_price | money }}</p><p>Shipping and taxes calculated at checkout.</p><button class="ps-action" type="submit" name="update">Update cart</button><button class="ps-action" type="submit" name="checkout">Checkout</button></form>{% else %}<p>Your cart is empty.</p><a class="ps-action" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% endif %}</div></section>
{% schema %}
{
  "name": "PS Cart",
  "settings": [],
  "presets": [
    {
      "name": "PS Cart"
    }
  ]
}
{% endschema %}
