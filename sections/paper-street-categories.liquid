<section class="ps-section ps-categories">
  <div class="ps-section-heading">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>
  <div class="ps-category-grid">
    {% for block in section.blocks %}
      <a class="ps-category-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'ps-category-card__image', alt: block.settings.title }}
        {% else %}
          <div class="ps-category-card__placeholder"></div>
        {% endif %}
        <span class="ps-category-card__shade"></span>
        <span class="ps-category-card__label">{{ block.settings.title }} <span aria-hidden="true">→</span></span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Paper Street categories",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY CATEGORY"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop the Street"}
  ],
  "blocks":[{"type":"category","name":"Category","settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"title","label":"Title","default":"Graded Cards"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "max_blocks":6,
  "presets":[{"name":"Paper Street categories","blocks":[
    {"type":"category","settings":{"title":"Graded Cards"}},
    {"type":"category","settings":{"title":"Raw Singles"}},
    {"type":"category","settings":{"title":"Autographs"}},
    {"type":"category","settings":{"title":"Wax & Breaks"}},
    {"type":"category","settings":{"title":"Memorabilia"}},
    {"type":"category","settings":{"title":"Consignment"}}
  ]}]
}
{% endschema %}
