
<section class="ps-social-videos">
  <div class="ps-social-videos__inner">

    <p class="ps-eyebrow">BEHIND THE SCENES</p>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="ps-social-videos__intro">
      {{ section.settings.description | escape }}
    </p>

    <div class="ps-social-videos__grid">

      {% for block in section.blocks %}
        <div class="ps-social-videos__card" {{ block.shopify_attributes }}>

          <h3>{{ block.settings.title | escape }}</h3>

          {% if block.settings.platform == 'instagram' %}

            {% assign reel_url = block.settings.video_url %}
            {% assign reel_url = reel_url | replace: '/reels/', '/reel/' %}

            {% if reel_url != blank %}
              <blockquote
                class="instagram-media"
                data-instgrm-permalink="{{ reel_url | escape }}"
                data-instgrm-version="14"
                style="background:#fff;max-width:540px;width:100%;margin:0 auto;">
                <a href="{{ reel_url | escape }}" target="_blank" rel="noopener noreferrer">
                  Watch on Instagram
                </a>
              </blockquote>
            {% endif %}

          {% elsif block.settings.platform == 'facebook' %}

            {% if block.settings.video_url != blank %}
              {% assign encoded_url = block.settings.video_url | url_encode %}

              <iframe
                src="https://www.facebook.com/plugins/video.php?href={{ encoded_url }}&show_text=false"
                width="100%"
                height="550"
                style="border:none;overflow:hidden"
                scrolling="no"
                frameborder="0"
                allow="autoplay;clipboard-write;encrypted-media;picture-in-picture;web-share"
                allowfullscreen="true"
                loading="lazy"
                title="{{ block.settings.title | escape }}">
              </iframe>
            {% endif %}

          {% endif %}

          {% if block.settings.video_url != blank %}
            <a
              class="ps-social-videos__link"
              href="{{ block.settings.video_url | escape }}"
              target="_blank"
              rel="noopener noreferrer">
              Watch on {{ block.settings.platform | capitalize }} &rarr;
            </a>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
.ps-social-videos {
  background: #0b0d0e;
  color: #f5f1e8;
  padding: 60px 24px 80px;
}

.ps-social-videos__inner {
  max-width: 1100px;
  margin: 0 auto;
}

.ps-social-videos h2 {
  font-size: clamp(30px, 4vw, 48px);
  margin: 12px 0;
}

.ps-social-videos__intro {
  color: #a9adb0;
  line-height: 1.7;
  margin-bottom: 32px;
}

.ps-social-videos__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
  align-items: start;
}

.ps-social-videos__card {
  background: #171a1c;
  border: 1px solid #34393d;
  padding: 20px;
  min-width: 0;
}

.ps-social-videos__card h3 {
  margin: 0 0 18px;
  font-size: 20px;
}

.ps-social-videos__card iframe {
  display: block;
  max-width: 100%;
  min-height: 550px;
}

.ps-social-videos__link {
  display: inline-block;
  color: #ff2d62;
  font-weight: 800;
  text-decoration: none;
  margin-top: 20px;
}

.ps-social-videos__link:hover {
  text-decoration: underline;
}

@media (max-width: 760px) {
  .ps-social-videos__grid {
    grid-template-columns: 1fr;
  }

  .ps-social-videos {
    padding: 40px 16px;
  }
}
</style>

<script src="https://www.instagram.com/embed.js" async></script>

{% schema %}
{
  "name": "PS Social Videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See Paper Street in Action"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From the show floor to your front door. Get a look at Paper Street Card Co. in action."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Social Video",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Video title",
          "default": "Paper Street Highlights"
        },
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            {"value": "instagram", "label": "Instagram"},
            {"value": "facebook", "label": "Facebook"}
          ],
          "default": "instagram"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PS Social Videos",
      "blocks": [
        {"type": "video"},
        {"type": "video"}
      ]
    }
  ]
}
{% endschema %}
