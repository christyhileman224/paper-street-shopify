<section class="ps-story">
  <div class="ps-story__content">
    <p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="ps-story__text">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank %}<a class="ps-btn ps-btn--primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }} →</a>{% endif %}
  </div>
  <div class="ps-story__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ps-story__image', alt: section.settings.heading }}
    {% else %}
      <div class="ps-story__placeholder"><span>Add your Paper Street show-floor photo in the theme editor.</span></div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Paper Street story",
  "settings":[
    {"type":"image_picker","id":"image","label":"Photo"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"ABOUT PAPER STREET"},
    {"type":"text","id":"heading","label":"Heading","default":"FROM THE SHOW FLOOR TO YOUR DOOR."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Paper Street Card Co. is a collectors shop specializing in sports cards, autographs, memorabilia, wax and more. Find us at card shows and online—always buying, selling and trading.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Learn more"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "presets":[{"name":"Paper Street story"}]
}
{% endschema %}
