
<section class="ps-feature-panels">
  <div class="ps-shell">
    <div class="ps-feature-panels__grid">
      {% for block in section.blocks %}
        <a class="ps-feature-panel" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ps-feature-panel__image' }}
          {% else %}
            <div class="ps-feature-panel__placeholder"></div>
          {% endif %}
          <div class="ps-feature-panel__overlay"></div>
          <div class="ps-feature-panel__content">
            <h2>{{ block.settings.heading }}</h2>
            {% if block.settings.subheading != blank %}<p>{{ block.settings.subheading }}</p>{% endif %}
            {% if block.settings.button_label != blank %}<span class="ps-feature-panel__button">{{ block.settings.button_label }} →</span>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.ps-feature-panels{background:#0b0d0e;padding:18px 0 44px}.ps-feature-panels__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ps-feature-panel{position:relative;min-height:290px;overflow:hidden;border:1px solid rgba(255,255,255,.14);background:#141719;color:#f5f1e8;text-decoration:none}.ps-feature-panel__image,.ps-feature-panel__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ps-feature-panel__placeholder{background:linear-gradient(135deg,#202427,#0b0d0e)}.ps-feature-panel__overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,13,14,.08),rgba(11,13,14,.9))}.ps-feature-panel__content{position:absolute;z-index:2;left:22px;right:22px;bottom:22px}.ps-feature-panel__content h2{margin:0 0 6px;font-size:clamp(1.6rem,2.3vw,2.45rem);line-height:.95;text-transform:uppercase}.ps-feature-panel__content p{margin:0 0 16px;opacity:.86;text-transform:uppercase;letter-spacing:.08em;font-size:.78rem}.ps-feature-panel__button{display:inline-block;border:1px solid #ff2d62;padding:10px 14px;font-weight:800;font-size:.78rem;text-transform:uppercase}.ps-feature-panel:hover{border-color:#ff2d62}@media(max-width:850px){.ps-feature-panels__grid{grid-template-columns:1fr}.ps-feature-panel{min-height:240px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Paper Street feature panels",
  "tag": "section",
  "class": "paper-street-feature-panels-section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "panel",
      "name": "Feature panel",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"heading","label":"Heading","default":"Featured Slabs"},
        {"type":"text","id":"subheading","label":"Subheading","default":"Iconic players. Investment grade."},
        {"type":"text","id":"button_label","label":"Button label","default":"Shop now"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Paper Street feature panels",
      "category": "Paper Street",
      "blocks": [
        {"type":"panel","settings":{"heading":"Featured Slabs","subheading":"Iconic players. Investment grade.","button_label":"Shop Graded"}},
        {"type":"panel","settings":{"heading":"Autographed Memorabilia","subheading":"Helmets, jerseys, footballs & more.","button_label":"Shop Autographs"}},
        {"type":"panel","settings":{"heading":"Wax & Breaks","subheading":"Sealed product. Big hits.","button_label":"Shop Wax"}}
      ]
    }
  ]
}
{% endschema %}
