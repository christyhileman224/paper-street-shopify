<section class="ps-feature-panels" aria-label="Featured collections">
  <div class="ps-feature-panels__grid">
    {% for block in section.blocks %}
      {% liquid
        assign panel_url = block.settings.link
        if panel_url == blank
          assign panel_url = routes.all_products_collection_url
        endif
      %}
      <a class="ps-feature-panel" href="{{ panel_url }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 750, 990, 1200', sizes: '(min-width: 900px) 33vw, 100vw', class: 'ps-feature-panel__image' }}
        {% else %}
          <div class="ps-feature-panel__placeholder" aria-hidden="true"></div>
        {% endif %}
        <div class="ps-feature-panel__shade" aria-hidden="true"></div>
        <div class="ps-feature-panel__content">
          <h2>{{ block.settings.heading | escape }}</h2>
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
          {% if block.settings.button_label != blank %}
            <span class="ps-feature-panel__button">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></span>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
.ps-feature-panels{background:#0b0d0e;padding:16px max(16px,calc((100vw - 1440px)/2)) 40px}
.ps-feature-panels__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.ps-feature-panel{position:relative;display:block;min-height:290px;overflow:hidden;border:1px solid #34383b;background:#171a1c;color:#f5f1e8;text-decoration:none}
.ps-feature-panel__image,.ps-feature-panel__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .3s ease}
.ps-feature-panel__placeholder{background:linear-gradient(130deg,#30363b,#111416)}
.ps-feature-panel__shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.94),rgba(0,0,0,.08) 80%)}
.ps-feature-panel__content{position:absolute;left:22px;right:22px;bottom:22px;z-index:1}
.ps-feature-panel__content h2{margin:0 0 8px;color:#f5f1e8;font-size:clamp(22px,2.3vw,36px);line-height:1;text-transform:uppercase;font-weight:900}
.ps-feature-panel__content p{margin:0 0 16px;color:#eee;font-size:12px;letter-spacing:.12em;text-transform:uppercase}
.ps-feature-panel__button{display:inline-block;border:1px solid #ff2d62;padding:11px 16px;font-size:12px;font-weight:800;letter-spacing:.05em;text-transform:uppercase}
.ps-feature-panel:hover{border-color:#ff2d62}.ps-feature-panel:hover .ps-feature-panel__image{transform:scale(1.04)}
.ps-feature-panel:focus-visible{outline:3px solid #ff477e;outline-offset:3px}
@media(max-width:900px){.ps-feature-panels__grid{grid-template-columns:1fr}.ps-feature-panel{min-height:260px}}
@media(prefers-reduced-motion:reduce){.ps-feature-panel__image{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "PS Feature Panels",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "panel",
      "name": "Feature panel",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "heading", "label": "Heading", "default": "Featured Slabs"},
        {"type": "text", "id": "text", "label": "Description", "default": "Iconic players. Investment grade."},
        {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop now"},
        {"type": "url", "id": "link", "label": "Destination link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "PS Feature Panels",
      "blocks": [
        {"type": "panel", "settings": {"heading": "Featured Slabs", "text": "Iconic players. Investment grade.", "button_label": "Shop Graded"}},
        {"type": "panel", "settings": {"heading": "Autographed Memorabilia", "text": "Helmets, jerseys, footballs & more.", "button_label": "Shop Autographs"}},
        {"type": "panel", "settings": {"heading": "Wax & Breaks", "text": "Sealed product. Big hits.", "button_label": "Shop Wax"}}
      ]
    }
  ]
}
{% endschema %}
