<a class="ps-card" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', widths: '240, 480, 650', sizes: '(min-width: 900px) 25vw, 50vw' }}{% else %}<div class="ps-empty-image">Photo coming soon</div>{% endif %}<h2>{{ product.title | escape }}</h2><p>{{ product.price | money }}{% unless product.available %} · Sold out{% endunless %}</p></a>